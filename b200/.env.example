# Copy to b200/.env — it is gitignored. scripts/lib.sh sources it automatically.

# Hugging Face token. Public repos work without it; gated LTX/Wan releases 401.
HF_TOKEN=

# Where models, the ComfyUI checkout and logs live. Point this at a large
# volume — full-precision LTX plus Wan 2.2 wants ~250GB.
# B200_WORKDIR=/mnt/models/b200

# ComfyUI bind address and port inside the container.
COMFY_HOST=0.0.0.0
COMFY_PORT=8188

# Host interface docker-compose publishes the port on. Keep 127.0.0.1 and use an
# SSH tunnel; ComfyUI has no authentication of its own.
COMFY_BIND=127.0.0.1

# sdpa (default, safest on Blackwell) | auto (let ComfyUI pick)
COMFY_ATTENTION=sdpa

# Extra ComfyUI flags. --highvram keeps weights resident, which is what you want
# on 180GB HBM3e.
# COMFY_EXTRA_ARGS=--highvram

# NGC PyTorch base image tag used by docker/Dockerfile.
# NGC_TAG=25.08-py3
