# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
FAMILY_STUDIO_PASSCODE=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Added automatically when Vercel Blob is connected.
BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN is injected by Vercel at runtime.
# BLOB_READ_WRITE_TOKEN can be used as a local/external fallback.
BLOB_READ_WRITE_TOKEN=

# Optional model overrides.
OPENAI_DIRECTOR_MODEL=
OPENAI_QC_MODEL=
GEMINI_VEO_FAST_MODEL=
GEMINI_VEO_STANDARD_MODEL=

# B200 Qwen vision Director/QC. The endpoint is OpenAI-compatible.
QWEN_API_BASE=https://b200-llm-node.technode.network/v1
QWEN_API_KEY=
QWEN_VISION_MODEL=x
DIRECTOR_AI_PROVIDER=openai
QC_AI_PROVIDER=openai
QWEN_OPENAI_FALLBACK=enabled

# B200 LTX-2.5 video worker. Keep the token server-only.
LTX_API_BASE=https://b200-llm-node.technode.network/ltx
LTX_API_KEY=
VIDEO_GENERATION_PROVIDER=auto
HYBRID_VIDEO_ROUTER_ENABLED=false

# B200 Wan 2.2 I2V for difficult body motion. Enable routing only after health succeeds.
WAN_API_BASE=https://b200-llm-node.technode.network/wan
WAN_API_KEY=

# B200 Qwen Image Edit for multi-reference Scene master frames.
QWEN_IMAGE_API_BASE=https://b200-llm-node.technode.network/image
QWEN_IMAGE_API_KEY=
SCENE_IMAGE_PROVIDER=gemini
SCENE_IMAGE_FALLBACK=enabled
