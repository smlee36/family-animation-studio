# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
FAMILY_STUDIO_PASSCODE=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Added automatically when Vercel Blob is connected.
BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN is injected by Vercel at runtime.
# BLOB_READ_WRITE_TOKEN can be used as a local/external fallback.
BLOB_READ_WRITE_TOKEN=

# Optional model overrides.
OPENAI_DIRECTOR_MODEL=
OPENAI_QC_MODEL=
GEMINI_VEO_FAST_MODEL=
GEMINI_VEO_STANDARD_MODEL=

# B200 LTX-2.5 video worker. Keep the token server-only.
LTX_API_BASE=https://b200-llm-node.technode.network/ltx
LTX_API_KEY=
VIDEO_GENERATION_PROVIDER=ltx
