# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
FAMILY_STUDIO_PASSCODE=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Added automatically when Vercel Blob is connected.
BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN is injected by Vercel at runtime.
# BLOB_READ_WRITE_TOKEN can be used as a local/external fallback.
BLOB_READ_WRITE_TOKEN=

# Optional model overrides for later phases.
OPENAI_DIRECTOR_MODEL=
VEO_MODEL=
